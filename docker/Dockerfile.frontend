# ==============================================================================
# Krea 2 LoRA Dataset Curation & Captioning Pipeline — Dockerfile.frontend
# Stage 1: Angular 22 Standalone + Signals + Tailwind v4 Production Build
# Stage 2: High-Performance Nginx Server with API & SSE/WebSocket Reverse Proxy
# ==============================================================================
FROM node:22-bookworm-slim AS frontend-builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY angular.json tsconfig.json tsconfig.app.json .postcssrc.json components.json ./
COPY src/web/ src/web/

RUN npm run build

# Stage 2: Nginx Reverse Proxy + Static Asset Server
FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-builder /app/src/web/dist/browser /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
