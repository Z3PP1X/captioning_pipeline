{
  "ci": {
    "collect": {
      "startServerCommand": "bash scripts/ux_gate.sh serve-lhci",
      "startServerReadyPattern": "lighthouse ready",
      "startServerReadyTimeout": 240000,
      "url": [
        "http://127.0.0.1:4300/#/studio/ingest",
        "http://127.0.0.1:4300/#/studio/triage",
        "http://127.0.0.1:4300/#/studio/captioning"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "port": 9222,
        "onlyCategories": ["performance", "accessibility", "best-practices"],
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }],
        "interactive": ["error", { "maxNumericValue": 2000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/reports"
    }
  }
}
