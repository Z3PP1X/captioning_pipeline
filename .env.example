# ==============================================================================
# Krea 2 LoRA Dataset Curation & Captioning Studio — .env.example
# Copy to `.env` and adjust `HOST_MEDIA_ROOT` for your WSL2 / Linux setup:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WSL2 / Host Media & Export Paths
# ------------------------------------------------------------------------------
# Windows NTFS mount via WSL2 (DrvFS) example:
#   HOST_MEDIA_ROOT=/mnt/c/Users/YourName/lora_raw_data
#   HOST_EXPORT_ROOT=/mnt/c/Users/YourName/lora_exports
#
# Native WSL2 Linux ext4 path example (fastest sequential I/O):
#   HOST_MEDIA_ROOT=/home/youruser/lora_raw_data
#   HOST_EXPORT_ROOT=/home/youruser/lora_exports
#
# NOTE ON WSL2 PERFORMANCE:
# Only raw input media (/data/input) and final exports (/data/exports) use host
# bind mounts. The SQLite WAL database, generated WebP thumbnails, and temporary
# extracted video frames are stored inside the named Docker volume `pipeline_appdata`
# on the native Linux ext4 filesystem to completely avoid the WSL2 /mnt/c 9P bottleneck.
HOST_MEDIA_ROOT=/mnt/c/Users/Public/lora_raw_data
HOST_EXPORT_ROOT=/mnt/c/Users/Public/lora_exports

# ------------------------------------------------------------------------------
# 2. OpenRouter API & 3-Tier VLM Model Cascade Defaults
# (All values can also be configured and persisted live via the Web UI!)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

PRIMARY_MODEL=google/gemini-2.5-pro
FALLBACK_MODEL_1=qwen/qwen-2.5-vl-72b-instruct
FALLBACK_MODEL_2=meta-llama/llama-3.2-90b-vision-instruct

# ------------------------------------------------------------------------------
# 3. Network Ports
# ------------------------------------------------------------------------------
FRONTEND_PORT=4200
BACKEND_PORT=8000
